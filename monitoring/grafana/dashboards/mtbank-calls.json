            "lineWidth": 0,
            "stacking": { "mode": "normal", "group": "A" },
            "axisSoftMin": 0,
            "gradientMode": "none",
            "showPoints": "never",
            "axisBorderShow": false,
            "axisLabel": "",
            "scaleDistribution": { "type": "linear" },
            "hideFrom": { "legend": false, "tooltip": false, "viz": false }
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "credits" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#3987e5" } }]
          },
          {
            "matcher": { "id": "byName", "options": "cards" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#d95926" } }]
          },
          {
            "matcher": { "id": "byName", "options": "transfers" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#199e70" } }]
          },
          {
            "matcher": { "id": "byName", "options": "complaints" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#c98500" } }]
          },
          {
            "matcher": { "id": "byName", "options": "other" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#d55181" } }]
          }
        ]
      }
    },
    {
      "id": 13,
      "type": "bargauge",
      "title": "Приоритет обращений",
      "description": "Порядковая шкала — окрашена статусной палитрой, а не палитрой серий.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 9, "w": 6, "x": 18, "y": 7 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (priority) (calls_by_priority_total)",
          "instant": true,
          "range": false,
          "legendFormat": "{{priority}}"
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "horizontal",
        "displayMode": "basic",
        "valueMode": "text",
        "showUnfilled": true,
        "minVizHeight": 16,
        "minVizWidth": 8,
        "namePlacement": "left",
        "sizing": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "min": 0,
          "mappings": [],
          "color": { "mode": "fixed", "fixedColor": "#0ca30c" }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "low" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#0ca30c" } }]
          },
          {
            "matcher": { "id": "byName", "options": "medium" },
